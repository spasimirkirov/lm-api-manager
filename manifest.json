{
  "manifest_version": 2,
  "plugin_name": "LM API Manager",
  "plugin_type": "llm_plugin",
  "version": "0.2.0",
  "executable": "LmApiManager.exe",
  "transport": {
    "kind": "http",
    "protocol": "openai"
  },
  "capabilities": {
    "persistent_worker": true,
    "services": ["chat"]
  },
  "commands": {
    "serve": "--serve --parent-pid {parent_pid}",
    "open_settings": "--settings"
  },
  "author": "spasimirkirov",
  "update": {
    "github": "spasimirkirov/lm-api-manager"
  }
}
